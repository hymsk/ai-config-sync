[Unit]
Description=ai-config-sync configuration synchronization agent
Documentation=https://github.com/hymsk/ai-config-sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际安装位置调整；pip install . 默认放入 /usr/local/bin
ExecStart=/usr/local/bin/ai-config-sync run
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
